{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web Debug (Vite + FastAPI)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "preLaunchTask": "Run All Dev Servers",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Tauri App (Tauri + FastAPI)",
      "type": "node-terminal",
      "request": "launch",
      "command": "echo 'Starting Tauri Desktop App...'",
      "preLaunchTask": "Run Tauri + Tauri Backend",
      "internalConsoleOptions": "neverOpen"
    },
    // ビルドタスクを実行してインストーラーを生成
    {
      "name": "Build All from Scratch (Installer)",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -NoProfile -Command \"Write-Host 'Build process finished successfully!' -ForegroundColor Green\"",
      "preLaunchTask": "Build All from Scratch (Windows)"
    },

    // ビルド後に生成された exe を直接立ち上げて動作確認
    {
      "name": "Build All & Launch App (.exe)",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -NoProfile -Command \"& '${workspaceFolder}/frontend/src-tauri/target/release/TenPla.exe'\"",
      "preLaunchTask": "Build All from Scratch (Windows)"
    }
  ]
}
