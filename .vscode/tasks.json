{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Web Backend",
      "type": "shell",
      // ポート 8001 を解放してから Uvicorn を起動
      "command": "(fuser -k 8001/tcp 2>/dev/null || npx --yes kill-port 8001 || true) && /workspace/backend/.venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8001",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Application startup complete\\."
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers",
        "close": true
      }
    },
    {
      "label": "Start Tauri Backend",
      "type": "shell",
      // ポート 8000 を解放してから Uvicorn を起動
      "command": "(fuser -k 8000/tcp 2>/dev/null || npx --yes kill-port 8000 || true) && /workspace/backend/.venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Application startup complete\\."
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers",
        "close": true
      }
    },
    {
      "label": "Start Web Frontend",
      "type": "shell",
      // ポート 5173 を解放してから npm run dev を起動
      "command": "(fuser -k 5173/tcp 2>/dev/null || npx --yes kill-port 5173 || true) && npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:\\s+http://localhost:5173/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers",
        "close": true
      }
    },
    {
      "label": "Run All Dev Servers",
      "dependsOn": ["Start Web Backend", "Start Web Frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Start Tauri Dev",
      "type": "shell",
      // Tauri 起動時開発用環境変数を注入して起動
      "command": "(fuser -k 5173/tcp 2>/dev/null || npx --yes kill-port 5173 || true) && npx tauri dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Running BeforeDevCommand",
          "endsPattern": "Watching .* for changes"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "tauri",
        "close": true
      }
    },
    {
      "label": "Run Tauri + Tauri Backend",
      "dependsOn": ["Start Tauri Backend", "Start Tauri Dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "TypeDoc Run",
      "type": "shell",
      "command": "cd frontend && npx --yes tsx scripts/add-jsdoc.ts",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
