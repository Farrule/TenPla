{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Web Backend",
      "type": "shell",
      // ポート 8001 を解放してから Uvicorn を起動
      "command": "(fuser -k 8001/tcp 2>/dev/null || npx --yes kill-port 8001 || true) && /workspace/backend/.venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8001",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Application startup complete\\."
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers",
        "close": true
      }
    },
    {
      "label": "Start Tauri Backend",
      "type": "shell",
      // ポート 8000 を解放してから Uvicorn を起動
      "command": "(fuser -k 8000/tcp 2>/dev/null || npx --yes kill-port 8000 || true) && /workspace/backend/.venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Application startup complete\\."
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers",
        "close": true
      }
    },
    {
      "label": "Start Web Frontend",
      "type": "shell",
      // ポート 5173 を解放してから npm run dev を起動
      "command": "(fuser -k 5173/tcp 2>/dev/null || npx --yes kill-port 5173 || true) && npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:\\s+http://localhost:5173/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers",
        "close": true
      }
    },
    {
      "label": "Run All Dev Servers",
      "dependsOn": ["Start Web Backend", "Start Web Frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Start Tauri Dev",
      "type": "shell",
      // Tauri 起動時開発用環境変数を注入して起動
      "command": "(fuser -k 5173/tcp 2>/dev/null || npx --yes kill-port 5173 || true) && npx tauri dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Running BeforeDevCommand",
          "endsPattern": "Watching .* for changes"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "tauri",
        "close": true
      }
    },
    {
      "label": "Run Tauri + Tauri Backend",
      "dependsOn": ["Start Tauri Backend", "Start Tauri Dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "TypeDoc Run",
      "type": "shell",
      "command": "cd frontend && npx --yes tsx scripts/add-jsdoc.ts",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Build All from Scratch (Windows)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Setup Backend Environment",
        "Setup Frontend Environment",
        "Build Backend (Sidecar)",
        "Deploy Sidecar Binary",
        "Build Tauri App"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    // 1. Python仮想環境の初期化と依存関係インストール
    {
      "label": "Setup Backend Environment",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "if (-not (Test-Path '.\\.venv')) { python -m venv .venv }; .\\.venv\\Scripts\\python.exe -m pip install --upgrade pip; .\\.venv\\Scripts\\python.exe -m pip install -r requirements.txt; .\\.venv\\Scripts\\python.exe -m pip install pyinstaller"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "close": true
      },
      "problemMatcher": []
    },
    // 2. フロントエンドの依存関係導入
    {
      "label": "Setup Frontend Environment",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "close": true
      },
      "problemMatcher": []
    },
    // 3. FastAPI バックエンドの Sidecar ビルド
    {
      "label": "Build Backend (Sidecar)",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "PyInstaller",
        "--noconfirm",
        "--onefile",
        "--windowed",
        "--name",
        "backend-server",
        "--add-data=app;app",
        "run_server.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "close": true
      },
      "problemMatcher": []
    },
    // 4. Tauri の binaries フォルダへリネーム配置
    {
      "label": "Deploy Sidecar Binary",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"New-Item -ItemType Directory -Force -Path frontend\\src-tauri\\binaries; Copy-Item backend\\dist\\backend-server.exe frontend\\src-tauri\\binaries\\backend-server-x86_64-pc-windows-msvc.exe -Force\"",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "close": true
      },
      "problemMatcher": []
    },
    // 5. Tauri アプリ・インストーラーのビルド
    {
      "label": "Build Tauri App",
      "type": "shell",
      "command": "npx tauri build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "close": false
      },
      "problemMatcher": []
    }
  ]
}
